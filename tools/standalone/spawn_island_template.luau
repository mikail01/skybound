-- SpawnOnIsland (standalone). GENERATED by tools/bake_spawn_island.py from
-- assets/spawn_island_ultra.obj - do not edit.
-- Put this in ServerScriptService as a Script (not a LocalScript) and press
-- Play. It needs nothing else: it builds the spawn island from the data
-- below (or uses an imported spawn_island_ultra model if there is one).
--   * Everyone spawns at the start of the stone path, facing the pit.
--   * The game's own portal trigger is moved into the pit at the end of the
--     path, so jumping in starts the game's climb exactly as before.
--   * Anyone the game sends back to its old hub lands on the island instead.
-- A message on screen says what happened.

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ISLAND_CENTER = Vector3.new(-2500, 300, -2500) -- meadow centre, away from other maps
local SCALE = 6.5 -- studs per map unit (the island is ~30 units across)
local LOW = 12.2 -- grass height in map units
local PATH_START = Vector3.new(0, 12.23, 12.6) -- start of the stone path, map units
local PIT = Vector3.new(0.2, 6.6, -0.3) -- bottom of the pit the path leads to
local PIT_RADIUS = 2.3 -- inside of the pit shaft, map units
-- Bounding-box centre and width of SpawnIsland_terrain, for an imported model.
local TERRAIN_CENTER = Vector3.new(0.45, 11.2, -0.35)
local TERRAIN_WIDTH = 30.54
local HOLD_SECONDS = 8 -- keep new characters on the island this long

local DATA = --[[DATA]]

local DECOR = { "SpawnIsland_nature_2" }
local function isDecor(name)
	if string.sub(name, -8) == "_Outline" then
		return true
	end
	for _, prefix in DECOR do
		if string.sub(name, 1, #prefix) == prefix then
			return true
		end
	end
	return false
end

local origin, unit = ISLAND_CENTER - Vector3.new(0, LOW, 0) * SCALE, SCALE
local function toWorld(p)
	return origin + p * unit
end

local function triangle(a, b, c, color, name, decor, parent)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local normal = ac:Cross(ab)
	if normal.Magnitude < 1e-6 or bc.Magnitude < 1e-6 then
		return
	end
	local right = normal.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	if height < 0.002 then
		return
	end
	for i, depth in { math.abs(ab:Dot(back)), math.abs(ac:Dot(back)) } do
		if depth >= 0.002 then
			local w = Instance.new("WedgePart")
			w.Name = name
			w.Anchored = true
			w.Material = Enum.Material.SmoothPlastic
			w.TopSurface = Enum.SurfaceType.Smooth
			w.BottomSurface = Enum.SurfaceType.Smooth
			w.Color = color
			w.Size = Vector3.new(0.15, height, depth)
			w.CFrame = if i == 1
				then CFrame.fromMatrix((a + b) / 2, right, up, back)
				else CFrame.fromMatrix((a + c) / 2, -right, up, -back)
			w.CanTouch = false
			if decor then
				w.CanCollide = false
				w.CanQuery = false
				w.CastShadow = false
			end
			w.Parent = parent
		end
	end
end

local function buildIsland()
	local model = Instance.new("Model")
	model.Name = "SpawnIsland"
	local palette = {}
	for i, hex in DATA.palette do
		palette[i] = Color3.fromHex(hex)
	end
	for _, mesh in DATA.meshes do
		local holder = Instance.new("Model")
		holder.Name = mesh.name
		holder.Parent = model
		local v, t = {}, {}
		for n in string.gmatch(mesh.verts, "%-?%d+") do
			table.insert(v, tonumber(n))
		end
		for n in string.gmatch(mesh.tris, "%-?%d+") do
			table.insert(t, tonumber(n))
		end
		local function vertex(i)
			local k = (i - 1) * 3
			return toWorld(Vector3.new(v[k + 1], v[k + 2], v[k + 3]) / 100)
		end
		local decor = isDecor(mesh.name)
		for k = 1, #t, 4 do
			triangle(vertex(t[k]), vertex(t[k + 1]), vertex(t[k + 2]), palette[t[k + 3]], mesh.name, decor, holder)
		end
	end
	model.Parent = workspace
	return model
end

-- Prefer an imported FloatingIslandMap if one is anywhere in the place.
-- An imported copy of the .obj (Studio's 3D Importer names its parts after
-- the .obj objects, e.g. SpawnIsland_terrain).
local function findImported()
	for _, container in { workspace, ServerStorage, ReplicatedStorage } do
		for _, d in container:GetDescendants() do
			if d:IsA("BasePart") and string.find(string.lower(d.Name), "spawnisland_terrain", 1, true) then
				local model = d
				while model.Parent and model.Parent ~= container and model.Parent:IsA("Model") do
					model = model.Parent
				end
				return model, d
			end
		end
	end
	return nil
end

local island, how
local imported, terrain = findImported()
if imported and terrain then
	if not imported:IsDescendantOf(workspace) then
		imported.Parent = workspace
	end
	for _, d in imported:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			if isDecor(d.Name) then
				d.CanCollide = false
			end
		end
	end
	-- Work in map units on the imported model, wherever and however big it is.
	unit = terrain.Size.X / TERRAIN_WIDTH
	origin = terrain.Position - TERRAIN_CENTER * unit
	island, how = imported, "imported"
else
	local ok, model = pcall(buildIsland)
	if not ok then
		warn("[SpawnOnIsland] could not build the island: " .. tostring(model))
		return
	end
	island, how = model, "built"
end
local spawnTop = toWorld(PATH_START)
local pitBottom = toWorld(PIT)
local portalCFrame = CFrame.new(pitBottom)

local spawn = Instance.new("SpawnLocation")
spawn.Name = "IslandSpawn"
spawn.Anchored = true
spawn.Neutral = true
spawn.Enabled = true
spawn.Duration = 0
spawn.Size = Vector3.new(10, 1, 10)
spawn.Transparency = 1
spawn.CanCollide = false
-- Facing up the path, toward the pit.
spawn.CFrame = CFrame.lookAt(spawnTop + Vector3.new(0, 0.6, 0), pitBottom * Vector3.new(1, 0, 1) + Vector3.new(0, spawnTop.Y + 0.6, 0))
local decal = spawn:FindFirstChildOfClass("Decal")
if decal then
	decal:Destroy()
end
spawn.Parent = workspace

local floor = Instance.new("Part")
floor.Name = "IslandSpawnFloor"
floor.Anchored = true
floor.Size = Vector3.new(16, 1, 16)
floor.Transparency = 1
floor.CFrame = CFrame.new(spawnTop - Vector3.new(0, 0.5, 0))
floor.Parent = workspace

-- The old hub: wherever the game's own SpawnLocations were.
local oldHubPoints = {}
local function disable(d)
	if d:IsA("SpawnLocation") and d ~= spawn then
		table.insert(oldHubPoints, d.Position)
		d.Enabled = false
	end
end
for _, d in workspace:GetDescendants() do
	disable(d)
end
workspace.DescendantAdded:Connect(disable)

-- The game's portal: a part with "portal" in its (or a parent's) name that a
-- script listens to touches on. Move it into the island's arch so its own
-- script still starts the climb.
local function portalScore(part)
	if part:IsDescendantOf(island) or part == spawn or part == floor or part.Name == "IslandPitTrigger" then
		return 0
	end
	local named = false
	local node = part
	while node and node ~= workspace do
		if string.find(string.lower(node.Name), "portal", 1, true) then
			named = true
			break
		end
		node = node.Parent
	end
	if not named then
		return 0
	end
	local touched = part:FindFirstChildOfClass("TouchTransmitter") ~= nil
	return (if touched then 10 else 1) + part.Size.Magnitude / 1000
end
local portalPart, best = nil, 0
for _, d in workspace:GetDescendants() do
	if d:IsA("BasePart") then
		local score = portalScore(d)
		if score > best then
			portalPart, best = d, score
		end
	end
end
local portalNote = "portal: not found (the pit sends you back to the path)"
local portalTouchedAt = {}
if portalPart and best >= 10 then
	-- Touch-listened part: stand it on the pit floor (with anything welded
	-- to it), keeping its own rotation.
	local cf, size = portalPart.CFrame, portalPart.Size
	local up = (
		math.abs(cf.RightVector.Y) * size.X
		+ math.abs(cf.UpVector.Y) * size.Y
		+ math.abs(cf.LookVector.Y) * size.Z
	) / 2
	local placed = CFrame.new(portalCFrame.Position + Vector3.new(0, up, 0)) * portalPart.CFrame.Rotation
	if portalPart.Anchored then
		portalPart.CFrame = placed
	else
		portalPart:PivotTo(placed)
	end
	portalPart.CanTouch = true
	portalNote = "portal: moved " .. portalPart.Name .. " into the pit"
elseif portalPart then
	portalNote = "portal: the pit relays to " .. portalPart.Name
end
if portalPart then
	portalPart.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if player then
			portalTouchedAt[player] = os.clock()
		end
	end)
end

-- The pit shaft: whoever drops in is put right on the game's portal (so its
-- own logic runs even if that part is small), or back on the path if the
-- game has no portal we could find.
local shaftHeight = (LOW - PIT.Y) * unit
local relay = Instance.new("Part")
relay.Name = "IslandPitTrigger"
relay.Anchored = true
relay.CanCollide = false
relay.CanQuery = false
relay.Transparency = 1
relay.Size = Vector3.new(PIT_RADIUS * 2 * unit, shaftHeight * 0.8, PIT_RADIUS * 2 * unit)
relay.CFrame = CFrame.new(pitBottom + Vector3.new(0, shaftHeight * 0.4, 0))
relay.Parent = workspace
local pitUsedAt = {}
relay.Touched:Connect(function(hit)
	local character = hit:FindFirstAncestorOfClass("Model")
	local player = character and Players:GetPlayerFromCharacter(character)
	if not player or os.clock() - (pitUsedAt[player] or 0) < 2 then
		return
	end
	pitUsedAt[player] = os.clock()
	if portalPart then
		portalTouchedAt[player] = os.clock()
		character:PivotTo(portalPart.CFrame)
	else
		character:PivotTo(CFrame.new(spawnTop + Vector3.new(0, 4, 0)))
	end
end)

local target = spawn.CFrame + Vector3.new(0, 3.4, 0)
local message = (if how == "imported"
	then "Spawn: imported island (" .. island.Name .. ")"
	else "Spawn: spawn island (built by SpawnOnIsland)") .. " | " .. portalNote

local function notify(player)
	local gui = Instance.new("ScreenGui")
	gui.Name = "SpawnOnIslandNotice"
	gui.ResetOnSpawn = false
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.new(0.5, 0, 0, 60)
	label.Size = UDim2.fromOffset(640, 40)
	label.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	label.BackgroundTransparency = 0.2
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Text = message
	label.Parent = gui
	gui.Parent = player:WaitForChild("PlayerGui", 10)
	task.delay(8, function()
		gui:Destroy()
	end)
end

local function onCharacter(character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	character:PivotTo(target)
	-- Other scripts may move new characters to their own hub: keep winning
	-- for a few seconds, then let go.
	local started = os.clock()
	while character.Parent and os.clock() - started < HOLD_SECONDS do
		task.wait(0.2)
		if (root.Position - target.Position).Magnitude > 120 then
			root.AssemblyLinearVelocity = Vector3.zero
			character:PivotTo(target)
		end
	end
end

local function onPlayer(player)
	player.RespawnLocation = spawn
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	task.spawn(notify, player)
end
Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayer, player)
end

-- Back from a run: when the game teleports someone onto its old hub ground,
-- send them to the island instead. Only sudden arrivals count (not walking
-- or falling there), and not right after they used the portal.
local lastPosition = {}
task.spawn(function()
	while true do
		task.wait(0.3)
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				local now = root.Position
				local before = lastPosition[player]
				lastPosition[player] = now
				local teleported = before ~= nil and (now - before).Magnitude > 200
				local recentPortal = os.clock() - (portalTouchedAt[player] or 0) < 6
				if teleported and not recentPortal then
					for _, point in oldHubPoints do
						local flat = Vector3.new(now.X - point.X, 0, now.Z - point.Z).Magnitude
						if flat < 150 and math.abs(now.Y - point.Y) < 40 then
							root.AssemblyLinearVelocity = Vector3.zero
							character:PivotTo(target)
							lastPosition[player] = target.Position
							break
						end
					end
				end
			end
		end
	end
end)
Players.PlayerRemoving:Connect(function(player)
	lastPosition[player] = nil
	portalTouchedAt[player] = nil
end)
print("[SpawnOnIsland] " .. message)
